# =====================================================================
#  Ease - local environment file.  NEVER commit this file.
#  Format:  NAME=value   (no spaces around "=", no quotes needed)
# =====================================================================

# ---------------------------------------------------------------------
# 1. LLM API KEYS  <-- PASTE YOUR KEYS HERE (leave blank if you don't have one)
# ---------------------------------------------------------------------
# Google AI Studio: https://aistudio.google.com  -> "Get API key"  (starts with AIza...)
GEMINI_API_KEY=

# Groq: https://console.groq.com -> API Keys  (starts with gsk_...)
GROQ_API_KEY=

# Optional - OpenRouter: https://openrouter.ai/keys  (starts with sk-or-...)
OPENROUTER_API_KEY=

# Optional - GitHub Models: GitHub -> Settings -> Developer settings -> Fine-grained token
#            (needs "Models: read" permission; starts with github_pat_...)
GITHUB_MODELS_TOKEN=

# Optional - local Ollama (only if installed), e.g. http://host.docker.internal:11434
OLLAMA_BASE_URL=

# Order the router tries providers in when one hits its free-tier limit
LLM_PROVIDER_ORDER=gemini,openrouter,github,ollama
LLM_TEXT_PROVIDER_ORDER=groq,gemini,openrouter,github,ollama

# ---------------------------------------------------------------------
# 2. CONNECTORS  (fill these later - not needed to start)
# ---------------------------------------------------------------------
NOTION_TOKEN=
NOTION_DATABASE_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
GOOGLE_SHEET_ID=

# ---------------------------------------------------------------------
# 3. INTERNAL SECRETS  (auto-generated - do not change, do not share)
# ---------------------------------------------------------------------
JWT_SECRET=change-me
VAULT_MASTER_KEY=change-me
POSTGRES_USER=ease
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ease
DATABASE_URL=postgresql+psycopg://ease:change-me@127.0.0.1:5432/ease
REDIS_URL=redis://127.0.0.1:6379

# ---------------------------------------------------------------------
# 4. FRONTEND
# ---------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000

# Local (non-Docker) runs: where the fixture sites are reachable from this machine
FIXTURES_BASE_URL=http://127.0.0.1:8080
HF_HUB_DISABLE_SYMLINKS_WARNING=1
HF_HUB_DISABLE_TELEMETRY=1
